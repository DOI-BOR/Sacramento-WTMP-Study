<?xml version="1.0" encoding="UTF-8"?>
<ScriptingAlt Name="Pre-Process_ResSim_SacTrn">
  <Description>
    <desc cnt="0" value="Pre-process any data into required ResSim-specific records for forecast simulations" />
  </Description>
  <ScriptFile>scripts/Pre-Process_ResSim_SacTrn.py</ScriptFile>
  <TimeStep>1HOUR</TimeStep>
  <DataLocations>
    <DataLocation Name="model_output" Class="hec2.model.DataLocation" DssPath="//model_output/temp-water//1HOUR/alt:ap:Scripting-Pre-Process_ResSim_Sac/" ComputeType="Computed" Model="CeQualW2-W2 Shasta 5" Parameter="Water Temperature" OutOfDate="false" PrevModelIndex="0">
      <ModelAlternative Name="Pre-Process_ResSim_SacTrn" Program="Scripting" />
      <DownStreamLocation>
        <DataLocation Name="Seg 77 Withdrawal" Class="hec2.model.DataLocation" DssPath="/W2:two_77.csv/Seg 77 Withdrawal/Temp-TWO//1HOUR/W2 5-Res:2018-03-FC:CeQualW2-W2 Shasta 5/" ComputeType="Computed" Parameter="Temp-TWO" OutOfDate="false" PrevModelIndex="0">
          <ModelAlternative Name="W2 Shasta 5" Program="CeQualW2" />
        </DataLocation>
      </DownStreamLocation>
    </DataLocation>
    <DataLocation Name="target_temp" Class="hec2.model.DataLocation" DssPath="//target_temp/temp-water//1HOUR/alt:ap:Scripting-Pre-Process_ResSim_Sac/" ComputeType="Computed" Model="DSS File" Parameter="temp-water" OutOfDate="false" PrevModelIndex="0">
      <ModelAlternative Name="Pre-Process_ResSim_SacTrn" Program="Scripting" />
      <DownStreamLocation>
        <DataLocation Name="SHASTA" Class="hec2.model.DssDataLocation" DssPath="/USBR/SHASTA/TEMP-WATER-TARGET//1Hour/SACTRN_BC_SCRIPT/" ComputeType="Computed" Parameter="TEMP-WATER-TARGET" OutOfDate="false" PrevModelIndex="0">
          <DssFile>shared/WTMP_SacTrn_Forecast.dss</DssFile>
        </DataLocation>
      </DownStreamLocation>
    </DataLocation>
  </DataLocations>
</ScriptingAlt>

